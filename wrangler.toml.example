# AnyRouter - Cloudflare Workers Configuration Example
# Copy this file to wrangler.toml and fill in your configuration

name = "anyrouter"
main = "anyrouter.js"
compatibility_date = "2024-01-01"

# ============================================
# Environment Variable Configuration
# ============================================
[vars]
# Admin Panel Password (must be changed!)
ADMIN_PASSWORD = "your-secure-password-here"

# Supabase Configuration (optional, if key management is required)
# How to get: https://supabase.com -> Create Project -> Settings -> API
SUPABASE_URL = "https://xxx.supabase.co"
SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Upstash Redis Configuration (optional, for statistics and caching)
# How to get: https://upstash.com -> Create Redis Database -> REST API
# Note: Use HTTPS URL, not redis:// protocol
UPSTASH_REDIS_URL = "https://xxx.upstash.io"
UPSTASH_REDIS_TOKEN = "AXxxxx..."

# ============================================
# KV Cache Configuration (optional, for high concurrency scenarios)
# ============================================
# Create KV namespace: npx wrangler kv:namespace create "CONFIG_CACHE"
# Then fill in the returned id below
# [[kv_namespaces]]
# binding = "CONFIG_KV"
# id = "your-kv-namespace-id"

# ============================================
# Use Secrets instead of plaintext configuration (recommended for production environments)
# ============================================
# Use wrangler secret to set sensitive information:
# npx wrangler secret put SUPABASE_URL
# npx wrangler secret put SUPABASE_KEY
# npx wrangler secret put ADMIN_PASSWORD
# npx wrangler secret put UPSTASH_REDIS_URL
# npx wrangler secret put UPSTASH_REDIS_TOKEN
